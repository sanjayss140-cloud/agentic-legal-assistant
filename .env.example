# ==============================================================================
# LexGround: Production Environment Configuration Example
# Copy this file to .env on your deployment host and fill in values.
# To generate cryptographic secrets, run: python scripts/generate_secrets.py
# ==============================================================================

# ----------------- 1. Upstream AI Provider (Required) -----------------
# Groq API key for LLaMA 3.3 70B & 3.1 8B inference
GROQ_API_KEY=gsk_your_groq_api_key_here

# ----------------- 2. Security & Cryptography (Required) -----------------
# 64-character hex secret for signing JWT access and refresh tokens
JWT_SECRET=generate_with_scripts_generate_secrets_py

# Application-level AES-256 Fernet key for encrypting case files at rest
ENCRYPTION_KEY=generate_with_scripts_generate_secrets_py

# ----------------- 3. Production Infrastructure (Docker Compose) -----------------
# Strong database password for the bundled PostgreSQL container
POSTGRES_PASSWORD=generate_with_scripts_generate_secrets_py

# Strong cache password for the bundled Redis container
REDIS_PASSWORD=generate_with_scripts_generate_secrets_py

# Public fully-qualified domain name (FQDN) for Caddy automatic HTTPS
DOMAIN_NAME=legal.yourfirm.com

# Contact email for Let's Encrypt SSL certificate issuance & renewal notices
ACME_EMAIL=admin@yourfirm.com

# ----------------- 4. Database Connection (Optional Overrides) -----------------
# For single-node / dev SQLite: sqlite:///data/lexground.db
# For production PostgreSQL: postgresql://lexground:${POSTGRES_PASSWORD}@postgres:5432/lexground
DATABASE_URL=sqlite:///data/lexground.db

# ----------------- 5. Quotas, Rate Limiting & Safety -----------------
# Maximum requests per minute per user
RATE_LIMIT_RPM=60

# Maximum documents stored per case matter
MAX_DOCS_PER_MATTER=50

# Maximum LLM tokens consumed per user per day
DAILY_TOKEN_BUDGET=100000

# Permitted CORS origins (comma-separated, without trailing slashes)
CORS_ORIGINS=https://legal.yourfirm.com,https://localhost,http://localhost:8000

# ----------------- 6. Server Binding -----------------
HOST=0.0.0.0
PORT=8000
